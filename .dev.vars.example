# =============================================================================
# Cloudflare Workers Local Environment Variables
# Copy this to .dev.vars and fill in your values
# NEVER commit .dev.vars — it contains secrets
# =============================================================================

# -----------------------------------------------------------------------------
# Firebase (if calling Firebase REST APIs from Workers)
# -----------------------------------------------------------------------------
FIREBASE_API_KEY=your-api-key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_APP_ID=your-app-id

# -----------------------------------------------------------------------------
# Agora (voice/video chat)
# -----------------------------------------------------------------------------
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate

# -----------------------------------------------------------------------------
# reCAPTCHA
# -----------------------------------------------------------------------------
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# -----------------------------------------------------------------------------
# Normcore (multiplayer networking)
# -----------------------------------------------------------------------------
NORMCORE_APP_KEY=your-normcore-app-key

# -----------------------------------------------------------------------------
# Cloudflare-specific (only needed for remote deployment, not local)
# -----------------------------------------------------------------------------
# CLOUDFLARE_ACCOUNT_ID=your-account-id
# CLOUDFLARE_API_TOKEN=your-api-token
