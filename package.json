{
  "name": "react-spaces-mono-repo",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm-run-all --parallel build:* && pnpm run prep-deploy",
    "build:webgl": "cross-env NODE_ENV=production pnpm --filter @disruptive-spaces/webgl run build",
    "build:header-auth-links": "cross-env NODE_ENV=production pnpm --filter @disruptive-spaces/header-auth-links run build",
    "build:chat": "cross-env NODE_ENV=production pnpm --filter @disruptive-spaces/chat run build",
    "build:testing": "cross-env NODE_ENV=production pnpm --filter @disruptive-spaces/testing run build",
    "prep-deploy": "shx rm -rf dist/ && shx mkdir -p dist && shx cp index.html dist/ && node scripts/manage-builds.js",
    "deploy": "pnpm run build && firebase deploy",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy:indexes": "firebase deploy --only firestore:indexes",
    "reset": "rimraf './node_modules' './packages/*/node_modules' './pnpm-lock.yaml' && pnpm install",
    "create-env": "node scripts/create-env.js",
    "setup": "pnpm run create-env && pnpm install",
    "dev": "pnpm --filter @disruptive-spaces/testing run dev",
    "dev:all": "pnpm -r --parallel run dev",
    "lint": "pnpm -r run lint",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --build",
    "typecheck:watch": "tsc --build --watch",
    "prepare": "husky"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.1.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitest/coverage-v8": "^4.0.18",
    "cross-env": "^7.0.3",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.2.7",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1",
    "rimraf": "^5.0.5",
    "shx": "^0.3.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "agora-rtc-react": "^2.3.0",
    "agora-rtc-sdk-ng": "^4.23.2",
    "dotenv": "^16.3.1",
    "firebase": "^11.5.0",
    "react-google-recaptcha": "^3.1.0"
  },
  "pnpm": {
    "overrides": {
      "react": "^18.2.0",
      "react-dom": "^18.2.0"
    }
  }
}
